# Copy to .env for local development. On Vercel, set these as
# Environment Variables in the project settings instead.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ShuttleSync

# Hosted MySQL usually requires TLS. Paste the provider's CA certificate
# (the whole PEM text) into DB_SSL_CA, or set DB_SSL=true to use the
# system CA store.
DB_SSL_CA=
DB_SSL=

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

CAMPUS_TIMEZONE=Asia/Karachi
